+static void
+mdb_cd_free(MDB_env *env)
+{
+	MDB_cdrop *cd = env->me_cdrop;
+	if (!cd)
+		return;
+	mdb_cd_freeq(&cd->cd_held);
+	mdb_cd_freeq(&cd->cd_delayed);
+	free(cd->cd_pend);
+	free(cd->cd_reused);
+	free(cd->cd_ov);
+	free(cd);
+	env->me_cdrop = NULL;
+}
