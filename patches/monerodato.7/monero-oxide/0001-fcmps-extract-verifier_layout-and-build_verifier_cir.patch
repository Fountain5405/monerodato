+  <C::C1 as Ciphersuite>::G: DivisorCurve<FieldElement = <C::C2 as Ciphersuite>::F>,
+  <C::C2 as Ciphersuite>::G: DivisorCurve<FieldElement = <C::C1 as Ciphersuite>::F>,
+{
+  c1_padded_pow_2: usize,
+  c2_padded_pow_2: usize,
+  c1_commitments: usize,
+  c2_commitments: usize,
+  root: Vec<Variable>,
+  c1_branches: Vec<Vec<Variable>>,
+  c2_branches: Vec<Vec<Variable>>,
+  input_openings: Vec<TranscriptedInput<C>>,
+  commitment_blind_claims_1: Vec<PointWithDlog<C::C2Parameters>>,
+  commitment_blind_claims_2: Vec<PointWithDlog<C::C1Parameters>>,
