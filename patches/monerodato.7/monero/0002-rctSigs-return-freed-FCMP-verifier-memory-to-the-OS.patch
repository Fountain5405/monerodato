From 994918a7874fe33bb499e3a780ec4bdf207b9a42 Mon Sep 17 00:00:00 2001
From: Fountain5405 <Fountain5405@users.noreply.github.com>
Date: Sun, 8 Nov 2026 13:21:03 +0000
Subject: [PATCH 2/11] rctSigs: return freed FCMP++ verifier memory to the OS

glibc keeps memory freed by a thread in that thread's arena. After batch
verification, every pool thread that ran a batch keeps its high-water mark
(about 200 MB for many-input proofs), so RSS grows to (threads) x (high-water
mark) and stays there after sync.

- After a call with proofs of 8 or more inputs: malloc_trim(0).
- After other calls: at most once every 10 s, because a trim after every light
  block cost +6% wall on 2-input blocks.
- From core::on_idle (checked every 2 s): one malloc_trim(0) once no batch
  verification has run for 5 s, so memory freed since the last trim is
  released when sync goes idle.
glibc only; on other C libraries the trims compile away.

Measured on a 12-core Ryzen 9 3900X (16 GB RAM, SATA SSD) with the previous commit, against
v0.19.0.0-beta.3.1 (no verifier change):
- stressnet blocks 3,105,401-3,105,444: peak anon -47.7%, after idle -88.6%,
  wall -7.3%;
- 2-input blocks: peak -24.4%, wall +0.2% (ranges overlap);
- long resync, 3 rounds: peak -47.7%, wall -1.5%;
- smallest cgroup memory limit that completes the heavy window: 3,000 MB
  against 5,562 MB (-46.1%).
The idle trim alone releases 231-234 MB at idle on the heavy window, with no
measurable change in peak, wall or CPU.

Memory only: what is verified, and every result, is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/cryptonote_core/cryptonote_core.cpp |  2 +
 src/cryptonote_core/cryptonote_core.h   |  1 +
 src/ringct/rctSigs.cpp                  | 49 +++++++++++++++++++++++++
 src/ringct/rctSigs.h                    |  3 ++
 4 files changed, 55 insertions(+)

diff --git a/src/cryptonote_core/cryptonote_core.cpp b/src/cryptonote_core/cryptonote_core.cpp
index ff0b05106..8023ef327 100644
--- a/src/cryptonote_core/cryptonote_core.cpp
+++ b/src/cryptonote_core/cryptonote_core.cpp
@@ -39,6 +39,7 @@ using namespace epee;
 #include <unordered_set>
 #include <thread>
 #include "cryptonote_core.h"
+#include "ringct/rctSigs.h"
 #include "common/util.h"
 #include "common/updates.h"
 #include "common/download.h"
@@ -1624,6 +1625,7 @@ namespace cryptonote
     m_block_rate_interval.do_call(boost::bind(&core::check_block_rate, this));
     m_blockchain_pruning_interval.do_call(boost::bind(&core::update_blockchain_pruning, this));
     m_diff_recalc_interval.do_call(boost::bind(&core::recalculate_difficulties, this));
+    m_fcmp_idle_trim_interval.do_call([]{ rct::idleTrimFcmpPp(5000); return true; });
     m_miner.on_idle();
     m_mempool.on_idle();
     return true;
diff --git a/src/cryptonote_core/cryptonote_core.h b/src/cryptonote_core/cryptonote_core.h
index 4bd83f7b5..121082616 100644
--- a/src/cryptonote_core/cryptonote_core.h
+++ b/src/cryptonote_core/cryptonote_core.h
@@ -1055,6 +1055,7 @@ namespace cryptonote
      epee::math_helper::once_a_time_seconds<90, false> m_block_rate_interval; //!< interval for checking block rate
      epee::math_helper::once_a_time_seconds<60*60*5, true> m_blockchain_pruning_interval; //!< interval for incremental blockchain pruning
      epee::math_helper::once_a_time_seconds<60*60*24*7, false> m_diff_recalc_interval; //!< interval for recalculating difficulties
+     epee::math_helper::once_a_time_seconds<2, false> m_fcmp_idle_trim_interval; //!< interval for the FCMP++ idle trim check
 
      std::atomic<bool> m_starter_message_showed; //!< has the "daemon will sync now" message been shown?
 
diff --git a/src/ringct/rctSigs.cpp b/src/ringct/rctSigs.cpp
index 57fb5bf56..a5d123cb4 100644
--- a/src/ringct/rctSigs.cpp
+++ b/src/ringct/rctSigs.cpp
@@ -37,6 +37,7 @@
 #include "common/perf_timer.h"
 #include "common/threadpool.h"
 #include <boost/thread/thread.hpp>
+#include <chrono>
 #include "common/util.h"
 #include "fcmp_pp/fcmp_pp_crypto.h"
 #include "fcmp_pp/fcmp_pp_types.h"
@@ -1665,6 +1666,36 @@ done:
       return true;
     }
 
+    // When the last FCMP++ batch verification ran, and when the last trim ran (steady_clock ms).
+    // Written by batchVerifyFcmpPpProofs, read by idleTrimFcmpPp from the core idle loop.
+    static std::atomic<std::int64_t> s_fcmp_last_verify_ms{0};
+    static std::atomic<std::int64_t> s_fcmp_last_trim_ms{0};
+
+    static inline std::int64_t steadyNowMs()
+    {
+      return std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+    bool idleTrimFcmpPp(std::int64_t idle_ms)
+    {
+#if defined(__GLIBC__)
+      const std::int64_t last_verify = s_fcmp_last_verify_ms.load(std::memory_order_relaxed);
+      if (last_verify == 0 || s_fcmp_last_trim_ms.load(std::memory_order_relaxed) >= last_verify)
+        return false; // nothing verified since the last trim
+      const std::int64_t now_ms = steadyNowMs();
+      if (now_ms - last_verify < idle_ms)
+        return false; // still verifying
+      s_fcmp_last_trim_ms.store(now_ms, std::memory_order_relaxed);
+      malloc_trim(0);
+      MGINFO("FCMP++ verification idle for " << (now_ms - last_verify) / 1000 << " s: returned freed verifier memory to the OS");
+      return true;
+#else
+      (void)idle_ms;
+      return false;
+#endif
+    }
+
     bool batchVerifyFcmpPpProofs(std::vector<fcmp_pp::FcmpPpVerifyInput> &&fcmp_pp_verify_inputs) {
       const std::size_t n_proofs = fcmp_pp_verify_inputs.size();
       if (n_proofs == 0)
@@ -1771,6 +1802,24 @@ done:
       if (multithreaded)
         CHECK_AND_ASSERT_THROW_MES(waiter.wait(), "Failed to batch verify FCMP++ proofs");
 
+      // Each batch just freed its large transient working set. glibc keeps freed memory in each
+      // thread's arena, so without a trim RSS grows to (threads that ever ran a batch) x (their
+      // high-water mark) and stays there after sync. Trim after every heavy call, which just freed
+      // large working sets; otherwise at most once every 10 s, since a trim after every light block
+      // costs wall time. The verification is recorded first, so that a trim here counts as "after
+      // the last verification" and the idle trim does not repeat it.
+#if defined(__GLIBC__)
+      {
+        const std::int64_t now_ms = steadyNowMs();
+        s_fcmp_last_verify_ms.store(now_ms, std::memory_order_relaxed);
+        if (heavy_call || now_ms - s_fcmp_last_trim_ms.load(std::memory_order_relaxed) >= 10000)
+        {
+          s_fcmp_last_trim_ms.store(now_ms, std::memory_order_relaxed);
+          malloc_trim(0);
+        }
+      }
+#endif
+
       for (bool r : results) {
         if (!r)
           return false;
diff --git a/src/ringct/rctSigs.h b/src/ringct/rctSigs.h
index 117911c6e..0518ab765 100644
--- a/src/ringct/rctSigs.h
+++ b/src/ringct/rctSigs.h
@@ -135,6 +135,9 @@ namespace rct {
     bool verRctSemanticsSimple(const rctSig & rv);
     bool verRctSemanticsSimple(const std::vector<const rctSig*> & rv);
     bool verRctNonSemanticsSimple(const rctSig & rv);
+    // Return freed FCMP++ verifier memory to the OS once no batch verification has run for idle_ms.
+    // Returns true if a trim was performed. No-op on non-glibc builds.
+    bool idleTrimFcmpPp(std::int64_t idle_ms);
     static inline bool verRctSimple(const rctSig & rv) { return verRctSemanticsSimple(rv) && verRctNonSemanticsSimple(rv); }
     xmr_amount decodeRct(const rctSig & rv, const key & sk, unsigned int i, key & mask, hw::device &hwdev);
     xmr_amount decodeRct(const rctSig & rv, const key & sk, unsigned int i, hw::device &hwdev);
