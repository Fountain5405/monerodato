From a85f57b418876e2802f168b020302efe102b285f Mon Sep 17 00:00:00 2001
From: Fountain5405 <Fountain5405@users.noreply.github.com>
Date: Sun, 8 Nov 2026 13:23:15 +0000
Subject: [PATCH 2/2] dalek-ff-group: wide_reduce and random through the 2^256
 = 38 fold

FieldElement::wide_reduce (used by from_uniform_bytes) and Field::random
reduced 512-bit values with a U512 division. They now read the 64 bytes as
eight 64-bit words and reduce them with the same 2^256 = 38 fold that
multiplication uses (Limbs::reduce_wide). The old reduce() is removed; the
U512 modulus remains for tests only.

Bounds: the mac chain's carry into the fold is at most 38, within the fold's
k <= 38 bound from the previous commit. The result can be non-canonical, as
0.5.0's could be, and every observable path (eq, to_repr, is_odd)
canonicalizes, so behaviour is the same.

Constant time: branch-free on x86-64 (disassembled; same conditions and
caveats as the previous commit). The word loop has a fixed trip count and
public indices.

Tests: 200,000 wide reductions in the differential against 0.5.0 (0
mismatches); the second reviewer ran 2,052 structured patterns (all-same limbs
over 16 limb values including 2^64-1 and 2^64-37..39; crosses with 0, p, 2p and
2^256-1 halves; 2,000 random), each followed by 8 chained operations on the
non-canonical result: 0 mismatches.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/field.rs | 20 +++++++++++++-------
 1 file changed, 13 insertions(+), 7 deletions(-)

diff --git a/src/field.rs b/src/field.rs
index d4f7303a5..49e866c9b 100644
--- a/src/field.rs
+++ b/src/field.rs
@@ -11,7 +11,9 @@ use subtle::{
   ConditionallySelectable,
 };
 
-use crypto_bigint::{Encoding, NonZero, U256, U512};
+use crypto_bigint::{Encoding, U256};
+#[cfg(test)]
+use crypto_bigint::U512;
 
 use group::ff::{Field, PrimeField, FieldBits, PrimeFieldBits, FromUniformBytes};
 
@@ -20,6 +22,7 @@ use crate::{u8_from_bool, constant_time, math_op, math};
 // 2 ** 255 - 19
 // Uses saturating_sub because checked_sub isn't available at compile time
 const MODULUS: U256 = U256::from_u8(1).shl_vartime(255).saturating_sub(&U256::from_u8(19));
+#[cfg(test)]
 const WIDE_MODULUS: U512 = U256::ZERO.concat(&MODULUS);
 
 /// An element of the field as four saturated 64-bit limbs, little-endian: any value below
@@ -290,10 +293,6 @@ const MOD_5_8: FieldElement = FieldElement::from_u256(&U256::from_be_hex(
   "0ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffd",
 ));
 
-fn reduce(x: U512) -> U256 {
-  U256::from_le_slice(&x.rem(&NonZero::new(WIDE_MODULUS).unwrap()).to_le_bytes()[.. 32])
-}
-
 constant_time!(FieldElement, Limbs);
 
 math!(
@@ -342,7 +341,7 @@ impl Field for FieldElement {
   fn random(mut rng: impl RngCore) -> Self {
     let mut bytes = [0; 64];
     rng.fill_bytes(&mut bytes);
-    Self::from_u256(&reduce(U512::from_le_bytes(bytes)))
+    Self::wide_reduce(bytes)
   }
 
   #[inline]
@@ -505,7 +504,14 @@ impl FieldElement {
   ///
   /// The bytes are interpreted in little-endian format.
   pub fn wide_reduce(value: [u8; 64]) -> Self {
-    Self::from_u256(&reduce(U512::from_le_bytes(value)))
+    // Eight 64-bit words, folded with 2**256 = 38 as a product would be
+    let mut words = [0; 8];
+    for (i, word) in words.iter_mut().enumerate() {
+      let mut le = [0; 8];
+      le.copy_from_slice(&value[(i * 8) .. ((i + 1) * 8)]);
+      *word = u64::from_le_bytes(le);
+    }
+    FieldElement(Limbs::reduce_wide(words))
   }
 
   /// Perform an exponentiation.
