+#[test]
+fn test_limb_edges() {
+  // Values just below and above p, built from raw limbs at the bounds the operations accept
+  let p = Limbs([MASK - 18, MASK, MASK, MASK, MASK]);
+  assert_eq!(p.to_bytes(), [0; 32]);
+  let p_plus_1 = Limbs([MASK - 17, MASK, MASK, MASK, MASK]);
+  assert_eq!(p_plus_1.to_bytes(), FieldElement::ONE.to_repr());
+  let big = Limbs([(1 << 52) - 1; 5]);
+  let big_fe = FieldElement(big);
+  // Compare against the same value assembled through U256 arithmetic, modulo p
+  let mut acc = FieldElement::ZERO;
+  for _ in 0 .. 5 {
+    acc *= FieldElement::from_u256(&U256::ONE.shl_vartime(51));
+    acc += FieldElement::from((1u64 << 52) - 1);
+  }
+  assert_eq!(big_fe, acc);
+  assert_eq!(big_fe * big_fe, acc * acc);
+  assert_eq!(big_fe.square(), acc * acc);
+  assert_eq!(FieldElement::ZERO - big_fe, -acc);
+  assert_eq!(big_fe + big_fe, acc.double());
