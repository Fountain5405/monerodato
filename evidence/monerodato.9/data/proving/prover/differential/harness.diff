+// W009 dot3 differential harness (scratch copy only, never part of monerodato).
+// Proves fixed-seed cases with the fcmps test helpers and writes each proof's bytes, so that two
+// builds (pristine and patched multiexp) can be compared byte for byte. Each proof is verified;
+// with DOT3_XDIR set, the other build's proof for the same case is read and verified too.
+//
+// DOT3_CASES: comma-separated n:layers:seed:kind. kind 0 = the crate's random_paths (n <= 18, the
+// paths share only the top layer); kind 1 = dot3_tree_paths below (a full tree, each path in its
+// own leaf chunk, shared upper layers; layers >= 2).
+
+use std::{env, fs, time::Instant};
+
+use super::*;
+use crate::dot3_rng::reseed;
+
+fn random_slots(width: usize) -> Vec<usize> {
+  let mut slots = (0 .. width).collect::<Vec<_>>();
+  for i in (1 .. width).rev() {
+    let j = usize::try_from(OsRng.next_u64() % u64::try_from(i + 1).unwrap()).unwrap();
+    slots.swap(i, j);
+  }
+  slots
+}
+
+fn dot3_tree_paths(
+  params: &FcmpParams<MoneroCurves>,
+  layers: usize,
+  n: usize,
+) -> (Vec<Path<MoneroCurves>>, TreeRoot<Selene, Helios>) {
+  assert!(layers >= 2);
+  let mut paths = vec![];
+  let mut selene_nodes: Vec<(<Selene as Ciphersuite>::G, Vec<usize>)> = vec![];
+  for i in 0 .. n {
+    let mut leaves = vec![];
+    while leaves.len() < LAYER_ONE_LEN {
+      leaves.push(random_output());
+    }
+    let output =
+      leaves[usize::try_from(OsRng.next_u64() % u64::try_from(leaves.len()).unwrap()).unwrap()];
+    let mut terms = vec![];
+    for (scalar, point) in leaves
+      .iter()
+      .flat_map(|output| {
+        let O = <Ed25519 as Ciphersuite>::G::to_xy(output.O).unwrap();
+        let I = <Ed25519 as Ciphersuite>::G::to_xy(output.I).unwrap();
+        let C = <Ed25519 as Ciphersuite>::G::to_xy(output.C).unwrap();
+        [O.0, O.1, I.0, I.1, C.0, C.1]
+      })
+      .zip(params.curve_1_generators.g_bold_slice())
+    {
+      terms.push((scalar, *point));
+    }
+    let hash = params.curve_1_hash_init + multiexp_vartime(&terms);
+    paths.push(Path { output, leaves, curve_2_layers: vec![], curve_1_layers: vec![] });
+    selene_nodes.push((hash, vec![i]));
+  }
+
+  let mut branch_layers = 0;
+  loop {
+    // Selene children, hashed on curve 2 (Helios), LAYER_TWO_LEN wide
+    let mut helios_nodes: Vec<(<Helios as Ciphersuite>::G, Vec<usize>)> = vec![];
+    for group in selene_nodes.chunks(LAYER_TWO_LEN) {
+      let mut children = (0 .. LAYER_TWO_LEN)
+        .map(|_| <Selene as Ciphersuite>::G::random(&mut OsRng))
+        .collect::<Vec<_>>();
+      let slots = random_slots(LAYER_TWO_LEN);
+      for (j, (point, _)) in group.iter().enumerate() {
+        children[slots[j]] = *point;
+      }
+      let xs = children
+        .iter()
+        .map(|point| <Selene as Ciphersuite>::G::to_xy(*point).unwrap().0)
+        .collect::<Vec<_>>();
+      let mut below = vec![];
+      for (_, idxs) in group {
+        for idx in idxs {
+          paths[*idx].curve_2_layers.push(xs.clone());
+          below.push(*idx);
+        }
+      }
+      let terms = xs
+        .iter()
+        .zip(params.curve_2_generators.g_bold_slice())
+        .map(|(scalar, point)| (*scalar, *point))
+        .collect::<Vec<_>>();
+      helios_nodes.push((params.curve_2_hash_init + multiexp_vartime(&terms), below));
+    }
+    branch_layers += 1;
+    if 1 + branch_layers == layers {
+      assert_eq!(helios_nodes.len(), 1, "{n} paths need more than {layers} layers");
+      return (paths, TreeRoot::C2(helios_nodes[0].0));
+    }
+
+    // Helios children, hashed on curve 1 (Selene), LAYER_ONE_LEN wide
+    selene_nodes = vec![];
+    for group in helios_nodes.chunks(LAYER_ONE_LEN) {
+      let mut children = (0 .. LAYER_ONE_LEN)
+        .map(|_| <Helios as Ciphersuite>::G::random(&mut OsRng))
+        .collect::<Vec<_>>();
+      let slots = random_slots(LAYER_ONE_LEN);
+      for (j, (point, _)) in group.iter().enumerate() {
+        children[slots[j]] = *point;
+      }
+      let xs = children
+        .iter()
+        .map(|point| <Helios as Ciphersuite>::G::to_xy(*point).unwrap().0)
+        .collect::<Vec<_>>();
+      let mut below = vec![];
+      for (_, idxs) in group {
+        for idx in idxs {
+          paths[*idx].curve_1_layers.push(xs.clone());
+          below.push(*idx);
+        }
+      }
+      let terms = xs
+        .iter()
+        .zip(params.curve_1_generators.g_bold_slice())
+        .map(|(scalar, point)| (*scalar, *point))
+        .collect::<Vec<_>>();
+      selene_nodes.push((params.curve_1_hash_init + multiexp_vartime(&terms), below));
+    }
+    branch_layers += 1;
+    if 1 + branch_layers == layers {
+      assert_eq!(selene_nodes.len(), 1, "{n} paths need more than {layers} layers");
+      return (paths, TreeRoot::C1(selene_nodes[0].0));
+    }
+  }
+}
