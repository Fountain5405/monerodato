+#[test]
+#[ignore = "W009 dot3 differential harness, run explicitly"]
+fn dot3_diff() {
+  let out = env::var("DOT3_OUT").unwrap();
+  let cases = env::var("DOT3_CASES").unwrap();
+  let xdir = env::var("DOT3_XDIR").ok();
+  let max_inputs: usize = env::var("DOT3_MAX_INPUTS").unwrap().parse().unwrap();
+
+  reseed(0xD073_D1FF);
+  let (G, T, U, V, params) = random_params(max_inputs);
+
+  for case in cases.split(',').filter(|case| !case.is_empty()) {
+    let v = case.split(':').map(|x| x.parse::<u64>().unwrap()).collect::<Vec<_>>();
+    let (n, layers, seed, kind) = (
+      usize::try_from(v[0]).unwrap(),
+      usize::try_from(v[1]).unwrap(),
+      v[2],
+      v[3],
+    );
+    let name = format!("{n}_{layers}_{seed}_{kind}");
+    reseed(seed.wrapping_mul(0x1_0000_0001) ^ (v[0] << 40) ^ (v[1] << 32) ^ (kind << 60));
+
+    let (paths, root) = match kind {
+      0 => random_paths(&params, layers, n),
+      1 => dot3_tree_paths(&params, layers, n),
+      _ => panic!("unknown kind"),
+    };
+    let mut output_blinds = vec![];
+    for _ in 0 .. n {
+      output_blinds.push(random_output_blinds(G, T, U, V));
+    }
+    let mut inputs = vec![];
+    for (path, output_blinds) in paths.iter().zip(&output_blinds) {
+      inputs.push(output_blinds.blind(&path.output).unwrap());
+    }
+    let branches = Branches::new(paths).unwrap();
+
+    let start = Instant::now();
+    let proof =
+      Fcmp::prove(&mut OsRng, &params, blind_branches(&params, branches, output_blinds)).unwrap();
+    let prove_ms = start.elapsed().as_millis();
+
+    let mut buf = vec![];
+    proof.write(&mut buf).unwrap();
+    assert_eq!(buf.len(), Fcmp::<MoneroCurves>::proof_size(n, layers));
+    fs::write(format!("{out}/{name}.bin"), &buf).unwrap();
+
+    reseed(seed ^ 0x5EED);
+    verify_fn(1, 1, &proof, &params, root, layers, &inputs);
+
+    let mut cross = "na";
+    if let Some(xdir) = &xdir {
+      let other = fs::read(format!("{xdir}/{name}.bin")).unwrap();
+      let other_proof = Fcmp::<MoneroCurves>::read(&mut other.as_slice(), n, layers).unwrap();
+      verify_fn(1, 1, &other_proof, &params, root, layers, &inputs);
+      cross = if other == buf { "same-and-verified" } else { "differs-but-verified" };
+    }
+    println!("DOT3CASE {name} len={} prove_ms={prove_ms} cross={cross}", buf.len());
+  }
+}
